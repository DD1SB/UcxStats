{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build UcxStats",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/UcxStats.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "run UcxStats",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/UcxStats.Wpf"],
      "problemMatcher": "$msCompile"
    }
  ]
}
