<Project>
  <PropertyGroup>
    <!-- Existing application baseline (MainWindow/README); the installer reads this source. -->
    <Version>0.12.3.3</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(UcxStatsWindowsPublish)' == 'true'">$(MSBuildProjectDirectory)/packages.win-x64.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)packaging/windows-publish.props"
          Condition="'$(UcxStatsWindowsPublish)' == 'true'" />
</Project>
