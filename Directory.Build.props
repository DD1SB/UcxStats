<Project>
  <PropertyGroup>
    <!-- Single application version; assemblies, publish metadata and installer derive from this source. -->
    <Version>0.12.3.5</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(UcxStatsWindowsPublish)' == 'true'">$(MSBuildProjectDirectory)/packages.win-x64.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)packaging/windows-publish.props"
          Condition="'$(UcxStatsWindowsPublish)' == 'true'" />
</Project>
