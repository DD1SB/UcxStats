<Window x:Class="UcxStats.Wpf.WaeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WAE Mixed" Height="820" Width="1400" WindowStartupLocation="CenterOwner">
<Grid Margin="12">
 <Grid.RowDefinitions>
  <RowDefinition Height="Auto"/>
  <RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/>
  <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <StackPanel>
   <TextBlock FontSize="22" FontWeight="Bold" Text="WAE Mixed"/>
   <TextBlock x:Name="SummaryText" Margin="0,4,0,0"/>
  </StackPanel>
  <Button Grid.Column="1" Width="110" Height="30" Click="Refresh_Click">Aktualisieren</Button>
 </Grid>

 <ItemsControl x:Name="ClassProgressList" Grid.Row="1" Margin="0,12,0,10">
  <ItemsControl.ItemsPanel>
   <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
  </ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
   <DataTemplate>
    <Border BorderBrush="#CCC" BorderThickness="1" Padding="10,6" Margin="0,0,8,0">
     <StackPanel>
      <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
      <TextBlock Text="{Binding StatusText}"/>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ItemsControl.ItemTemplate>
 </ItemsControl>

 <DataGrid x:Name="WaeGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
           EnableRowVirtualization="True" EnableColumnVirtualization="True"
           SelectionUnit="Cell" MouseDoubleClick="WaeGrid_MouseDoubleClick"
           HorizontalScrollBarVisibility="Auto">
  <DataGrid.Columns>
   <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="65"/>
   <DataGridTextColumn Header="WAE-Land" Binding="{Binding Country}" Width="210"/>
   <DataGridTextColumn Header="Punkte" Binding="{Binding Points}" Width="65"/>
  </DataGrid.Columns>
 </DataGrid>

 <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="Gray"
            Text="✓ bestätigt · ○ gearbeitet, aber weder in UCX noch per DCL bestätigt · Doppelklick auf eine Bandzelle zeigt die zugehörigen QSOs."/>
</Grid></Window>
