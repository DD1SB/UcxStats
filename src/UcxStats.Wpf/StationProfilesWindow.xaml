<Window x:Class="UcxStats.Wpf.StationProfilesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Stationsprofile" Height="520" Width="760" WindowStartupLocation="CenterOwner">
<Grid Margin="12">
 <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ListBox x:Name="ProfileList" DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged"/>
 <Grid Grid.Column="2">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock FontWeight="Bold" FontSize="16" Text="Stationsprofil" Margin="0,0,0,10"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
   <TextBlock Text="Locator" VerticalAlignment="Center"/>
   <TextBox x:Name="LocatorBox" Grid.Column="1" CharacterCasing="Upper" ToolTip="Maidenhead-Locator mit 2/4/6/8/10 Zeichen"/>
   <Button Grid.Column="2" Margin="8,0,0,0" Click="LocatorToCoordinates_Click">→ Lat/Lon</Button>
  </Grid>
  <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="Koordinaten" VerticalAlignment="Center"/>
   <TextBox x:Name="LatitudeBox" Grid.Column="1" ToolTip="Breitengrad, -90 bis +90"/>
   <TextBlock Grid.Column="2" Text="/" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <TextBox x:Name="LongitudeBox" Grid.Column="3" ToolTip="Längengrad, -180 bis +180"/>
  </Grid>
  <TextBlock Grid.Row="4" Margin="130,3,0,0" Foreground="Gray" Text="Latitude / Longitude – manuelle Werte sind maßgeblich."/>
  <Grid Grid.Row="5" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="Standorthöhe [m]" VerticalAlignment="Center"/><TextBox x:Name="ElevationBox" Grid.Column="1"/>
  </Grid>
  <Grid Grid.Row="6" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="Antenne" VerticalAlignment="Center"/><TextBox x:Name="AntennaBox" Grid.Column="1"/>
  </Grid>
  <StackPanel Grid.Row="7" Margin="0,8,0,0"><TextBlock Text="Antennenhöhe [m]"/><TextBox x:Name="AntennaHeightBox"/></StackPanel>
  <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Width="90" Margin="0,0,8,0" Click="New_Click">Neu</Button>
   <Button Width="90" Margin="0,0,8,0" Click="Delete_Click">Löschen</Button>
   <Button Width="90" Click="Save_Click">Speichern</Button>
  </StackPanel>
 </Grid>
</Grid></Window>