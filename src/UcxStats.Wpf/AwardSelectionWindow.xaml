<Window x:Class="UcxStats.Wpf.AwardSelectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Diplome" Height="430" Width="720" WindowStartupLocation="CenterOwner">
<Grid Margin="12">
 <Grid.RowDefinitions>
  <RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/>
  <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>
 <TextBlock FontSize="21" FontWeight="Bold" Text="Diplome" Margin="0,0,0,10"/>
 <ListBox x:Name="AwardList" Grid.Row="1" MouseDoubleClick="AwardList_MouseDoubleClick">
  <ListBox.ItemTemplate>
   <DataTemplate>
    <Border Padding="8">
     <StackPanel>
      <TextBlock FontSize="16" FontWeight="Bold">
       <Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Variant}"/>
      </TextBlock>
      <TextBlock Margin="0,3,0,0" Text="{Binding Description}" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ListBox.ItemTemplate>
 </ListBox>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
  <Button Width="90" Margin="0,0,8,0" IsCancel="True">Schließen</Button>
  <Button Width="110" IsDefault="True" Click="Open_Click">Öffnen</Button>
 </StackPanel>
</Grid></Window>
