<Window x:Class="UcxStats.Wpf.DxccMapSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kartenoptionen" Height="455" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Linienbreiten" Padding="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Label Target="{Binding ElementName=ShortpathWidthBox}" VerticalAlignment="Center">Shortpath (px)</Label>
                    <ComboBox x:Name="ShortpathWidthBox" Grid.Column="1" Margin="8,0,16,0"
                              VerticalContentAlignment="Center" ItemStringFormat="{}{0:0.##}"/>
                    <Label Grid.Column="2" Target="{Binding ElementName=LongpathWidthBox}" VerticalAlignment="Center">Longpath (px)</Label>
                    <ComboBox x:Name="LongpathWidthBox" Grid.Column="3" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" ItemStringFormat="{}{0:0.##}"/>
                </Grid>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="0,5–8 px in 0,5-px-Schritten; bisheriger Shortpath-Standard zusätzlich: 1,3 px. Speichern aktualisiert alle offenen Karten sofort."/>
                <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3" Click="ResetWidths_Click">Linienbreiten zurücksetzen</Button>
            </StackPanel>
        </GroupBox>
        <TextBlock Grid.Row="1" Margin="0,12,0,0" FontWeight="SemiBold" Text="DXCC-Kartenoverlay"/>
        <TextBlock Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="UcxStats verteilt keine DXCC-Geometrie. Wählen Sie eine externe dxcc.geojson; sie wird beim Öffnen einer Karte validiert und normalisiert."/>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="GeoJsonPathBox" Height="28" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Width="90" Margin="8,0,0,0" Click="Browse_Click">Durchsuchen…</Button>
            <Button Grid.Column="2" Width="80" Margin="8,0,0,0" Click="Validate_Click">Prüfen</Button>
        </Grid>
        <CheckBox x:Name="EnabledByDefaultCheck" Grid.Row="4" Margin="0,12,0,0">
            DXCC-Overlay bei neuen Karten standardmäßig einschalten
        </CheckBox>
        <Border Grid.Row="5" Margin="0,12,0,0" Padding="8" Background="#FFF3F3F3" CornerRadius="3">
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" VerticalAlignment="Top"/>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="105" Click="Clear_Click">Pfad löschen</Button>
            <Button Width="90" Margin="8,0,0,0" IsDefault="True" Click="Save_Click">Speichern</Button>
            <Button Width="90" Margin="8,0,0,0" IsCancel="True">Abbrechen</Button>
        </StackPanel>
    </Grid>
</Window>
