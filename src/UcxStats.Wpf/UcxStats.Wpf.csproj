<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UcxStats.Core\UcxStats.Core.csproj" />
    <ProjectReference Include="..\UcxStats.Data\UcxStats.Data.csproj" />
    <ProjectReference Include="..\UcxStats.Geo\UcxStats.Geo.csproj" />
    <ProjectReference Include="..\UcxStats.Map\UcxStats.Map.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Leaflet\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
