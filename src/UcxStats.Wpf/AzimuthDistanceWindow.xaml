<Window x:Class="UcxStats.Wpf.AzimuthDistanceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="UcxStats – Azimut / Distanz" Height="850" Width="950" WindowStartupLocation="CenterOwner">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <TextBlock Text="Darstellung:" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <ComboBox x:Name="PathModeCombo" Width="120" SelectedIndex="0" SelectionChanged="PathModeCombo_SelectionChanged">
     <ComboBoxItem Content="Shortpath" Tag="short"/>
     <ComboBoxItem Content="Longpath" Tag="long"/>
     <ComboBoxItem Content="Beide" Tag="both"/>
    </ComboBox>
   </StackPanel>
   <TextBlock x:Name="HeaderText" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Border Grid.Row="1" Margin="10" Background="White" BorderBrush="#CCC" BorderThickness="1">
   <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_SizeChanged"/>
  </Border>
  <TextBlock x:Name="StatusText" Grid.Row="2" Margin="10,0,10,10"/>
 </Grid>
</Window>