<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\UcxStats.Core\UcxStats.Core.csproj" />
    <ProjectReference Include="..\..\src\UcxStats.Data\UcxStats.Data.csproj" />
    <ProjectReference Include="..\..\src\UcxStats.Map\UcxStats.Map.csproj" />
    <ProjectReference Include="..\UcxStats.SmokeTest\UcxStats.SmokeTest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Exercise the actual host import service on Linux without loading WPF. -->
    <Compile Include="..\..\src\UcxStats.Wpf\UcxImportService.cs" Link="Import\UcxImportService.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\ucx-mapping-v2-baseline.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\map-ui-refinement.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\map-runtime.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\map-statistics.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\map-source-reconciliation.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\map-path-widths.cjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
